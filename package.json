{
  "name": "t3-code-chrome",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that hands GitHub pull requests to T3 Code sessions without leaving the PR page.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.content.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "package": "pnpm build && cd dist && zip -qr ../t3-code-chrome.zip . -x '*.map'",
    "screenshots": "pnpm build && node test/e2e/showcase.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.3.0",
    "preact": "^10.29.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@crxjs/vite-plugin": "^3.0.0",
    "@preact/preset-vite": "^2.10.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "playwright": "1.64.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
